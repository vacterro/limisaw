# Runtime config, generated on first launch; carries window position and machine paths
LIMISAW.ini

# SAIPEN project memory — private working state, not for the public repo
.saipen/

# Caches and build artifacts
*.bak
*.tmp
*.old

# Test binaries built by build.ps1 -Tests
tests/bin/
tests/*.exe
tests/*.pdb
tests/PROOF-*.txt

# Windows junk
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Personal shortcuts
*.lnk

# The built exe is a release asset, not source: csc (Framework 4.x) has no -deterministic,
# so a tracked binary was byte-different on every build and git status was never clean.
LIMISAW.exe
